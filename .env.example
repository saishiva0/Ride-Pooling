# RidePool — Root Environment Example
# Copy to .env as needed for local development. Never commit real secrets.

# Runtime
NODE_ENV=development

# Backend
PORT=4000
DATABASE_URL=postgresql://ridepool:ridepool_dev@localhost:5433/ridepool?schema=public

# Backend — future placeholders (do NOT activate unused integrations)
# CORS_ORIGIN=http://localhost:8081
# JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN=7d
# MAP_PROVIDER=
# MAP_API_KEY=
# PUSH_PROVIDER=
# PUSH_API_KEY=
# SOCKET_ENABLED=false
# PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# Mobile — exposed to the app bundle via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=http://localhost:4000