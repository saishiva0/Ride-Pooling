# RidePool Backend — local development environment
# Copy values as needed. Never commit real secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ridepool:ridepool_dev@localhost:5433/ridepool?schema=public

# Future placeholders (do NOT activate unused integrations):
# CORS_ORIGIN=http://localhost:8081
# MAP_PROVIDER=
# MAP_API_KEY=
# SOCKET_ENABLED=false

# Push notifications (OD-008 — Phase 3.23). Expo Notifications + Expo Push
# Service; backend-only secrets, never expose EXPO_ACCESS_TOKEN to the mobile
# bundle. Unset/false by default → push dispatch is a no-op (ride/request
# operations, persisted notifications, and Socket.io realtime all work
# normally; only the push channel is disabled) until explicitly enabled.
# PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# Phone + OTP authentication (OD-005 — Phase 3.18). Backend-only secrets; never
# expose MSG91_AUTH_KEY to the mobile bundle. Unset by default → OTP fails
# closed (no OTP can be sent or verified) until real credentials are added.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SMSIND
# MSG91_BASE_URL=https://api.msg91.com
# MSG91_OTP_EXPIRY_MINUTES=5
# MSG91_OTP_LENGTH=6
# SESSION_TTL_DAYS=30

# Matching policy (OD-004 — Phase 3.19). Server-controlled product thresholds:
# callers can never supply these. Values shown are the approved V1 defaults and
# can be omitted; tune only with a deliberate product decision.
# MATCHING_PICKUP_RADIUS_METERS=5000
# MATCHING_DEPARTURE_WINDOW_MINUTES=60
# MATCHING_DESTINATION_TOLERANCE_METERS=5000
# MATCHING_MAX_RESULTS=20