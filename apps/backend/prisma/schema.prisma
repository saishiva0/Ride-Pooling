// Prisma schema — Phase 2: Domain Model & Database.
// Chat persistence added for V1.1 Phase 3.25.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(version: "3.6.2")]
}

enum RideStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ParticipantStatus {
  CONFIRMED
  CANCELLED
}

enum PricingType {
  STANDARD
  CUSTOM
}

enum NotificationType {
  RIDE_CREATED
  RIDE_PUBLISHED
  RIDE_UPDATED
  RIDE_REQUESTED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  RIDE_CONFIRMED
  RIDE_STARTED
  RIDE_CANCELLED
  RIDE_COMPLETED
  RIDE_EXPIRED
  CHAT_MESSAGE
}

enum ReportReason {
  UNSAFE_BEHAVIOR
  HARASSMENT
  NO_SHOW
  FRAUD_OR_SCAM
  INAPPROPRIATE_CONTENT
  OTHER
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRides      Ride[]              @relation("RideCreator")
  rideRequests      RideRequest[]
  participations    RideParticipant[]
  notifications     Notification[]
  statusChanges     RideStatusHistory[] @relation("StatusChangeActor")
  sessions          AuthSession[]
  devicePushTokens  DevicePushToken[]
  reportsFiled      Report[]            @relation("ReportsFiled")
  reportsReceived   Report[]            @relation("ReportsReceived")
  blocksCreated     Block[]             @relation("BlocksCreated")
  blocksReceived    Block[]             @relation("BlocksReceived")
  chatMessagesSent  ChatMessage[]
  chatReadStates    ChatReadState[]
}

model Location {
  id        String   @id @default(cuid())
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  point Unsupported("geometry")? @default(dbgenerated("st_setsrid(st_makepoint((longitude)::double precision, (latitude)::double precision), 4326)"))
  pickupRides      Ride[] @relation("RidePickupLocation")
  destinationRides Ride[] @relation("RideDestinationLocation")
  @@index([point], type: Gist)
}

model Ride {
  id                    String      @id @default(cuid())
  creatorId             String
  pickupLocationId      String
  destinationLocationId String
  departureDateTime     DateTime
  totalSeats            Int
  vehicleType           String?
  discoveryRadiusKm     Float?
  pricingType           PricingType
  pricePerKm            Decimal     @db.Decimal(6, 2)
  estimatedDistanceKm   Decimal?    @db.Decimal(8, 2)
  estimatedContribution Decimal?    @db.Decimal(10, 2)
  status                RideStatus  @default(DRAFT)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  creator             User     @relation("RideCreator", fields: [creatorId], references: [id])
  pickupLocation      Location @relation("RidePickupLocation", fields: [pickupLocationId], references: [id])
  destinationLocation Location @relation("RideDestinationLocation", fields: [destinationLocationId], references: [id])
  requests      RideRequest[]
  participants  RideParticipant[]
  statusHistory RideStatusHistory[]
  notifications Notification[]
  reports       Report[]
  chatConversation ChatConversation?
  @@index([creatorId])
  @@index([status])
  @@index([departureDateTime])
  @@index([status, departureDateTime])
  @@index([pickupLocationId])
  @@index([destinationLocationId])
}

model RideRequest {
  id             String            @id @default(cuid())
  rideId         String
  userId         String
  requestedSeats Int               @default(1)
  status         RideRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resolvedAt     DateTime?
  ride Ride @relation(fields: [rideId], references: [id])
  user User @relation(fields: [userId], references: [id])
  participant   RideParticipant?
  notifications Notification[]
  @@index([rideId])
  @@index([userId])
  @@index([rideId, status])
  @@index([status])
}

model RideParticipant {
  id             String            @id @default(cuid())
  rideId         String
  userId         String
  requestId      String            @unique
  seatsAllocated Int
  status         ParticipantStatus @default(CONFIRMED)
  joinedAt       DateTime          @default(now())
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ride    Ride        @relation(fields: [rideId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
  request RideRequest @relation(fields: [requestId], references: [id])
  @@index([rideId])
  @@index([userId])
}

model RideStatusHistory {
  id              String      @id @default(cuid())
  rideId          String
  fromStatus      RideStatus?
  toStatus        RideStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime    @default(now())
  ride      Ride  @relation(fields: [rideId], references: [id])
  changedBy User? @relation("StatusChangeActor", fields: [changedByUserId], references: [id])
  @@index([rideId, createdAt])
  @@index([rideId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String?
  body      String?
  readAt    DateTime?
  rideId    String?
  requestId String?
  createdAt DateTime         @default(now())
  user    User         @relation(fields: [userId], references: [id])
  ride    Ride?        @relation(fields: [rideId], references: [id])
  request RideRequest? @relation(fields: [requestId], references: [id])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([rideId])
  @@index([requestId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
}

model DevicePushToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  platform    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastSeenAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, token])
  @@index([userId])
  @@index([userId, isActive])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  rideId     String?
  reason     ReportReason
  detail     String?
  createdAt  DateTime     @default(now())
  reporter User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  reported User  @relation("ReportsReceived", fields: [reportedId], references: [id])
  ride     Ride? @relation(fields: [rideId], references: [id])
  @@index([reporterId])
  @@index([reporterId, createdAt])
  @@index([reportedId])
  @@index([rideId])
}

model Block {
  id          String    @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime  @default(now())
  unblockedAt DateTime?
  blocker User @relation("BlocksCreated", fields: [blockerId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id])
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@index([blockerId, unblockedAt])
}

model ChatConversation {
  id        String   @id @default(cuid())
  rideId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  readStates ChatReadState[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime         @default(now())
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}

model ChatReadState {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime
  updatedAt      DateTime @updatedAt
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id])
  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
}
