[TEMPLATE]
# RidePool Mobile — Environment Example
# Copy to .env to override defaults. Never commit real secrets.
# Only EXPO_PUBLIC_* variables are inlined into the app bundle by Expo.

# Backend API base URL (no trailing slash). Defaults to http://localhost:4000.
# - Web / iOS simulator: http://localhost:4000
# - Android emulator:    http://10.0.2.2:4000
# - Physical device:     http://<your-machine-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Realtime endpoint (reserved). Realtime is DISABLED by default: the backend
# realtime layer is off (SOCKET_ENABLED=false) and sockets fail closed while
# OD-005/OD-008 are open. Leave unset — the mobile realtime boundary is
# provider-neutral and the fail-closed default is used until a transport is
# actually configured.
# EXPO_PUBLIC_REALTIME_URL=ws://localhost:4000/ws

# Google Maps Platform API key (Phase 3.20 / OD-007). Optional — when unset the
# map/geocoding/routing wiring FAILS CLOSED (the app stays fully functional,
# maps render an explanatory placeholder, and location-based screens show a
# clear "unavailable" state instead of a fabricated coordinate).
#
# The key is EXPO_PUBLIC_* because it ships inside the app bundle. Restrict it
# to your Android app (package + signing cert) and/or iOS app (bundle id) AND to
# the Maps SDK for Android/iOS, Geocoding API, and Routes API only. Never use a
# server-side (web) key here, never commit a real key.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
